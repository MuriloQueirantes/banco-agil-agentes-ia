# Chave da API do Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_API_KEY=cole_sua_chave_aqui

# Opcionais
# Por padrão usamos o alias gemini-flash-latest, que acompanha o modelo flash
# mais recente. Descomente para fixar uma versão exata:
# BANCO_AGIL_MODEL=gemini-3.8-flash
# BANCO_AGIL_TEMPERATURE=0.2
